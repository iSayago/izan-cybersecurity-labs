---
import type { VideoData } from '../lib/media';
import VideoEmbed from './VideoEmbed.astro';

interface Props {
  original?: VideoData;
  summary?: VideoData;
}

const { original, summary } = Astro.props;
const shouldRender = Boolean(original || summary);
---

{shouldRender && (
<section class="report-section" aria-labelledby="video-title">
  <div class="report-section-head">
    <h2 id="video-title" class="report-section-title">Registro audiovisual</h2>
    <span class="report-section-index">VIDEO / 16:9 + 9:16</span>
  </div>

  <div class="video-pair">
    <figure class="video-card">
      <div class="video-card-head">
        <span><b>Grabación de la práctica</b></span>
        <span>16:9 · versión editada</span>
      </div>
      <div class="video-frame">
        {original && <VideoEmbed video={original} fallbackLabel="Grabación editada de la práctica" />}
      </div>
      <figcaption class="video-caption">
        <b>Registro editado.</b> Cortes sobre la grabación del laboratorio; solo se
        conservan las ejecuciones que terminaron correctamente.
      </figcaption>
    </figure>

    <figure class="video-card">
      <div class="video-card-head">
        <span><b>Resumen vertical</b></span>
        <span>9:16 · LinkedIn</span>
      </div>
      <div class="video-frame video-frame-vertical">
        {summary && <VideoEmbed video={summary} vertical fallbackLabel="Resumen vertical de la práctica" />}
      </div>
      <figcaption class="video-caption">
        <b>Resumen de 15–20 s.</b> Rótulos y fragmentos de la misma grabación, sin
        resultados añadidos.
      </figcaption>
    </figure>
  </div>
</section>
)}
