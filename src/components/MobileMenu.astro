---
import { site } from '../data/site';
import { withBase } from '../lib/url';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
---

<dialog id="mobile-menu" class="menu-dialog" aria-label="Menú de navegación">
  <div class="menu-inner">
    <div class="menu-top">
      <Logo />
      <button class="icon-button" type="button" data-menu-close aria-label="Cerrar menú">
        <Icon name="close" size={18} />
      </button>
    </div>

    <nav class="menu-nav" aria-label="Navegación móvil">
      {
        site.nav.map((item, index) => (
          <a class="menu-link" href={withBase(item.href)} data-menu-link>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        ))
      }
      <a class="menu-link" href={withBase('/about/#contacto')} data-menu-link>
        <span>{String(site.nav.length + 1).padStart(2, '0')}</span>
        Contacto
      </a>
    </nav>

    <div class="menu-foot">
      <p>{site.course.program} · {site.course.issuer}</p>
      <p>{site.course.status} · {site.course.labsCompleted} prácticas realizadas</p>
      <SocialLinks stacked />
      <p class="mt-4 text-[var(--color-muted)]">
        Sitio estático. Sin formularios ni backend.
      </p>
    </div>
  </div>
</dialog>
