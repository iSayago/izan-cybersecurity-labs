---
import { withBase } from '../lib/url';

interface Props {
  src: string;
  alt: string;
  caption: string;
  index?: string;
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  caption,
  index = 'FIG.',
  width = 1200,
  height = 750,
} = Astro.props;

const imageSrc = src.startsWith('/') ? withBase(src) : src;
---

<figure class="figure">
  <div class="figure-frame">
    <img src={imageSrc} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </div>
  <figcaption>
    <span class="figure-index">{index}</span>
    <span>{caption}</span>
  </figcaption>
</figure>
