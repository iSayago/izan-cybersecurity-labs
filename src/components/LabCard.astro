---
import type { LabEntry } from '../lib/content';
import { formatDate, labPath, moduleOf, readingTime } from '../lib/content';
import { withBase } from '../lib/url';
import Icon from './Icon.astro';
import ModuleArt from './ModuleArt.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  entry: LabEntry;
  variant?: 'default' | 'featured';
}

const { entry, variant = 'default' } = Astro.props;
const module = moduleOf(entry);
const href = withBase(labPath(entry));
const minutes = readingTime(entry.body);
const cover = entry.data.cover ? withBase(entry.data.cover) : null;
---

<article
  class:list={['card', variant === 'featured' && 'card-featured']}
  data-lab-item
  data-title={entry.data.title}
  data-module={entry.data.module}
  data-practice={entry.data.practice}
  data-categories={entry.data.categories.join('|')}
  data-tags={entry.data.tags.join('|')}
  data-date={entry.data.date?.getTime() ?? 0}
  data-status={entry.data.status}
>
  <div class="cover">
    {
      cover ? (
        <img
          src={cover}
          alt={entry.data.coverAlt ?? ''}
          loading="lazy"
          decoding="async"
          width="800"
          height="500"
        />
      ) : (
        <ModuleArt moduleId={entry.data.module} variant={variant === 'featured' ? 'featured' : 'card'} />
      )
    }
    <div class="cover-badges">
      <StatusBadge status={entry.data.status} />
      <span class="badge badge-module">Módulo {entry.data.module}</span>
    </div>
  </div>

  <div class="card-body">
    <div class="card-kicker">
      <span class="accent">Práctica {String(entry.data.practice).padStart(2, '0')}</span>
      <span aria-hidden="true">/</span>
      <span>{entry.data.categories[0] ?? module.label}</span>
    </div>

    <h3 class="card-title">
      <a class="stretched-link" href={href}>{entry.data.title}</a>
    </h3>

    <p class="card-desc">{entry.data.description}</p>

    {entry.data.tags.length > 0 && (
      <ul class="chip-row" aria-label="Etiquetas">
        {entry.data.tags.slice(0, 4).map((tag) => <li class="tag">{tag}</li>)}
      </ul>
    )}

    <div class="card-foot">
      <span>{formatDate(entry.data.date)} · {minutes} min</span>
      <Icon name="arrow-up-right" size={13} />
    </div>
  </div>
</article>

<style>
  .card-featured :global(.card-title) {
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
  }

  .card-featured :global(.card-body) {
    padding: 1.2rem 1.25rem 1.25rem;
  }

  .stretched-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
  }
</style>
