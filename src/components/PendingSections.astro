---
import type { ReportSection } from '../lib/report';

interface Props {
  missing: ReportSection[];
  total: number;
  demo?: boolean;
}

const { missing, total, demo = false } = Astro.props;
---

{
  missing.length > 0 && (
    <section class="pending-panel" aria-labelledby="pending-title">
      <p class="micro-label">Cobertura del informe</p>
      <h2 id="pending-title">
        {missing.length} de {total} secciones pendientes de documentar
      </h2>
      <p>
        {demo
          ? 'Este informe de demostración no completa todas las secciones a propósito, para mostrar cómo se representa la cobertura documental. Los apartados que faltan aparecen aquí.'
          : 'La página se publica sin rellenar huecos con información inventada. Añade cada apartado en el Markdown cuando tengas el contenido y la evidencia correspondientes.'}
      </p>
      <ul class="pending-list">
        {missing.map((section) => (
          <li class="pending-item">
            <span>
              <strong>{section.label}</strong> — {section.hint}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )
}
