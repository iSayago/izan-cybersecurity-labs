---
import { withBase } from '../lib/url';
import Icon from './Icon.astro';
---

<dialog
  id="search-dialog"
  class="search-dialog"
  aria-labelledby="search-dialog-title"
  data-index-url={withBase('/search-index.json')}
>
  <div class="search-head">
    <Icon name="search" size={17} />
    <h2 id="search-dialog-title" class="sr-only">Buscar en el archivo</h2>
    <label for="search-input" class="sr-only">Buscar prácticas, writeups y etiquetas</label>
    <input
      id="search-input"
      class="search-input"
      type="search"
      placeholder="Buscar prácticas, writeups, etiquetas…"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="true"
      aria-controls="search-results"
    />
    <button class="icon-button search-close" type="button" data-search-close aria-label="Cerrar búsqueda">
      <Icon name="close" size={16} />
    </button>
  </div>

  <div class="search-hint">
    <span>Archivo completo</span>
    <span><kbd>↑</kbd> <kbd>↓</kbd> navegar</span>
    <span><kbd>Enter</kbd> abrir</span>
    <span><kbd>Esc</kbd> cerrar</span>
  </div>

  <div
    id="search-results"
    class="search-results"
    role="listbox"
    aria-label="Resultados de búsqueda"
  >
    <p class="search-empty">Escribe para buscar en laboratorios y publicaciones.</p>
  </div>

  <div class="search-foot">
    <span data-search-count aria-live="polite">— resultados</span>
    <span>SOC LABS / WRITEUPS / AI SECURITY</span>
  </div>
</dialog>
