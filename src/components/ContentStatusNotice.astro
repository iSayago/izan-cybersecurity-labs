---
import type { ContentStatus } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  status: ContentStatus;
}

const { status } = Astro.props;
---

{
  status === 'demo' && (
    <div class="notice notice-demo" role="note">
      <div class="notice-row">
        <span class="badge badge-demo">Demostración</span>
        <strong>Contenido de ejemplo, no una práctica realizada.</strong>
      </div>
      <p>
        Este informe describe un escenario sintético y existe únicamente para mostrar
        la estructura documental del archivo. No se ha atribuido a Izan ninguna
        actividad, evidencia ni resultado real.
      </p>
    </div>
  )
}

{
  status === 'pending' && (
    <div class="notice notice-pending" role="note">
      <div class="notice-row">
        <Icon name="info" size={15} />
        <strong>Documentación pendiente.</strong>
      </div>
      <p>
        Esta página está reservada para un informe que todavía no se ha publicado.
        No se muestran resultados, herramientas ni conclusiones inventadas. La
        cobertura del informe se indica más abajo.
      </p>
    </div>
  )
}
