---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContentStatusNotice from '../../components/ContentStatusNotice.astro';
import Icon from '../../components/Icon.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import TagList from '../../components/TagList.astro';
import {
  formatDate,
  formatLongDate,
  getPosts,
  isoDate,
  postPath,
  readingTime,
} from '../../lib/content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.status !== 'draft');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const posts = await getPosts();
const index = posts.findIndex((post) => post.id === entry.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const minutes = readingTime(entry.body);
const noindex = entry.data.status === 'demo';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  url: canonical,
  mainEntityOfPage: canonical,
  datePublished: isoDate(entry.data.date),
  dateModified: isoDate(entry.data.updated ?? entry.data.date),
  author: {
    '@type': 'Person',
    name: 'Izan',
    url: new URL(withBase('/about/'), siteUrl).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'IZAN | Cybersecurity Labs',
  },
  keywords: [entry.data.category, ...entry.data.tags].join(', '),
  articleSection: entry.data.category,
  inLanguage: 'es',
  isAccessibleForFree: true,
  ...(entry.data.cover ? { image: new URL(withBase(entry.data.cover), siteUrl).toString() } : {}),
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.cover ?? '/og-default.png'}
  imageAlt={entry.data.coverAlt ?? entry.data.title}
  noindex={noindex}
  type="article"
  publishedTime={isoDate(entry.data.date)}
  modifiedTime={isoDate(entry.data.updated ?? entry.data.date)}
  tags={entry.data.tags}
  showProgress
  jsonLd={articleJsonLd}
>
  <article>
    <header class="report-head wrap">
      <Breadcrumbs
        items={[
          { label: 'Writeups', href: withBase('/blog/') },
          { label: entry.data.category, href: withBase('/blog/') },
          { label: 'Nota' },
        ]}
      />

      <div class="report-badges">
        <StatusBadge status={entry.data.status} />
        <span class="badge badge-module">{entry.data.category}</span>
        {entry.data.readingLevel && (
          <span class="badge badge-no-dot">Nivel {entry.data.readingLevel}</span>
        )}
        {noindex && <span class="badge badge-pending badge-no-dot">No indexada</span>}
      </div>

      <h1 class="report-title">{entry.data.title}</h1>
      <p class="report-lede">{entry.data.description}</p>

      <dl class="report-meta">
        <div>
          <dt>Fecha</dt>
          <dd>{formatLongDate(entry.data.date)}</dd>
        </div>
        <div>
          <dt>Categoría</dt>
          <dd>{entry.data.category}</dd>
        </div>
        <div>
          <dt>Lectura</dt>
          <dd>{minutes} min</dd>
        </div>
        <div>
          <dt>Etiquetas</dt>
          <dd>{entry.data.tags.length}</dd>
        </div>
      </dl>

      <div class="report-actions">
        <a class="btn btn-ghost" href={withBase('/blog/')}>
          <Icon name="arrow-left" size={13} /> Volver al archivo
        </a>
        <a class="btn btn-ghost" href={withBase('/labs/')}>
          <Icon name="shield" size={13} /> SOC Labs
        </a>
      </div>

      <TagList tags={entry.data.tags} linked basePath="/blog/" />
    </header>

    <div class="report-grid wrap">
      <div class="report-main">
        <ContentStatusNotice status={entry.data.status} />

        {headings.length > 0 && (
          <details class="toc-mobile">
            <summary>
              <span>En esta página</span>
              <span>{headings.length} apartados</span>
            </summary>
            <TableOfContents headings={headings} compact />
          </details>
        )}

        <div class="report-section">
          <div class="report-section-head">
            <h2 class="report-section-title">Nota técnica</h2>
            <span class="report-section-index">WRITEUP / {formatDate(entry.data.date)}</span>
          </div>
          <div class="prose" id="informe">
            <Content />
          </div>
        </div>

        <nav class="report-pager" aria-label="Otras publicaciones">
          {newer ? (
            <a class="pager-link" href={withBase(postPath(newer))}>
              <span class="pager-label"><Icon name="arrow-left" size={12} /> Más reciente</span>
              <span class="pager-title">{newer.data.title}</span>
            </a>
          ) : (
            <span class="pager-link pager-link-empty">
              <span class="pager-label">Más reciente</span>
              <span class="pager-title">Esta es la última nota publicada</span>
            </span>
          )}

          {older ? (
            <a class="pager-link pager-link-next" href={withBase(postPath(older))}>
              <span class="pager-label">Anterior en el archivo <Icon name="arrow-right" size={12} /></span>
              <span class="pager-title">{older.data.title}</span>
            </a>
          ) : (
            <span class="pager-link pager-link-empty pager-link-next">
              <span class="pager-label">Anterior</span>
              <span class="pager-title">No hay notas más antiguas</span>
            </span>
          )}
        </nav>
      </div>

      <aside class="report-aside">
        {headings.length > 0 && <TableOfContents headings={headings} />}

        <div class="fiche">
          <p class="fiche-head">Ficha de la nota</p>
          <dl>
            <div class="fiche-row">
              <dt>Estado</dt>
              <dd>{entry.data.status === 'demo' ? 'Demostración' : 'Publicada'}</dd>
            </div>
            <div class="fiche-row">
              <dt>Categoría</dt>
              <dd>{entry.data.category}</dd>
            </div>
            <div class="fiche-row">
              <dt>Fecha</dt>
              <dd>{formatDate(entry.data.date)}</dd>
            </div>
            {entry.data.updated && (
              <div class="fiche-row">
                <dt>Actualizada</dt>
                <dd>{formatDate(entry.data.updated)}</dd>
              </div>
            )}
            <div class="fiche-row">
              <dt>Lectura</dt>
              <dd>{minutes} min</dd>
            </div>
            <div class="fiche-row">
              <dt>Etiquetas</dt>
              <dd>{entry.data.tags.length}</dd>
            </div>
          </dl>
        </div>

        <p class="aside-note">
          Las notas DEMO validan el formato editorial. No describen investigaciones
          reales ni resultados atribuibles a Izan.
        </p>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .aside-note {
    margin-top: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    line-height: 1.7;
    color: var(--color-muted);
  }
</style>
