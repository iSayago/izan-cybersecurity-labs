---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, getPosts, postPath, readingTime, unique } from '../../lib/content';
import { withBase } from '../../lib/url';

const posts = await getPosts();
const categories = unique(posts.map((post) => post.data.category)).sort((a, b) =>
  a.localeCompare(b, 'es'),
);
const tags = unique(posts.flatMap((post) => post.data.tags)).sort((a, b) => a.localeCompare(b, 'es'));
const published = posts.filter((post) => post.data.status === 'published').length;
const demo = posts.filter((post) => post.data.status === 'demo').length;
const latest = posts[0];
---

<BaseLayout
  title="Writeups"
  description="Investigaciones técnicas, notas de método y documentación extensa sobre operaciones SOC, Blue Team y análisis de eventos."
>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Writeups / Investigación y método</p>
      <h1 class="page-title">Notas de <em>trabajo.</em></h1>
      <p class="page-lede">
        Investigaciones técnicas, documentación extensa y notas de método. El archivo
        prioriza procedimientos reproducibles y límites explícitos sobre titulares.
      </p>

      <div class="stat-row">
        <div class="stat">
          <strong>{String(posts.length).padStart(2, '0')}</strong>
          <span>Publicaciones</span>
        </div>
        <div class="stat">
          <strong>{String(categories.length).padStart(2, '0')}</strong>
          <span>Categorías</span>
        </div>
        <div class="stat">
          <strong>{String(published).padStart(2, '0')}</strong>
          <span>Revisadas</span>
        </div>
        <div class="stat">
          <strong>{String(demo).padStart(2, '0')}</strong>
          <span>Demos de formato</span>
        </div>
      </div>

      <p class="page-meta">
        <span>Última nota: {formatDate(latest?.data.date)}</span>
        <a class="link" href={withBase('/rss.xml')}>Suscribirse por RSS</a>
      </p>
    </div>
  </header>

  <section class="section" aria-labelledby="archive-title">
    <div class="wrap">
      <div class="section-head">
        <span class="section-index" aria-hidden="true">01</span>
        <div class="section-head-copy">
          <h2 class="section-title" id="archive-title">Archivo de writeups</h2>
          <p class="section-desc">
            Filtra por categoría, etiqueta o texto. Las notas de demostración están
            identificadas y no describen incidentes reales.
          </p>
        </div>
      </div>

      <form class="filter-bar filter-bar-blog" id="post-filter-form" role="search">
        <div class="field">
          <label for="post-search">Buscar</label>
          <div class="search-field">
            <Icon name="search" size={14} />
            <input
              class="input"
              id="post-search"
              name="q"
              type="search"
              placeholder="Título, etiqueta, concepto…"
              autocomplete="off"
            />
          </div>
        </div>

        <div class="field">
          <label for="post-category">Categoría</label>
          <select class="select" id="post-category" name="category">
            <option value="all">Todas</option>
            {categories.map((category) => <option value={category}>{category}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="post-tag">Etiqueta</label>
          <select class="select" id="post-tag" name="tag">
            <option value="all">Todas</option>
            {tags.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
        </div>

        <div class="filter-actions">
          <button class="filter-reset" type="reset" form="post-filter-form">Limpiar</button>
        </div>
      </form>

      <p class="filter-count" id="post-count" aria-live="polite">
        {posts.length} publicaciones
      </p>

      {
        posts.length > 0 ? (
          <div class="post-list">
            {posts.map((post, index) => (
              <article
                class:list={['post-item', post.data.featured && 'post-item-featured']}
                data-post-item
                data-title={post.data.title}
                data-categories={post.data.category}
                data-tags={post.data.tags.join('|')}
              >
                <a class="post-link" href={withBase(postPath(post))}>
                  <span class="post-index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="post-main">
                    <span class="post-meta">
                      <span class="post-category">{post.data.category}</span>
                      <span>{formatDate(post.data.date)}</span>
                      <span>{readingTime(post.body)} min</span>
                      {post.data.status === 'demo' && <span class="entry-status-demo">DEMO</span>}
                    </span>
                    <span class="post-title">{post.data.title}</span>
                    <span class="post-desc">{post.data.description}</span>
                    <span class="chip-row">
                      {post.data.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
                    </span>
                  </span>
                  <span class="post-arrow" aria-hidden="true">
                    <Icon name="arrow-up-right" size={15} />
                  </span>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h3>El archivo está vacío.</h3>
            <p>Las primeras notas se publicarán aquí cuando estén revisadas.</p>
          </div>
        )
      }

      <div class="empty-state" id="post-empty" hidden>
        <h3>Ninguna publicación coincide con el filtro.</h3>
        <p>Prueba con otra categoría, otra etiqueta o limpia la búsqueda.</p>
        <button class="btn btn-ghost mt-5" type="reset" form="post-filter-form">Limpiar filtros</button>
      </div>

      {
        demo > 0 && (
          <p class="legend-line">
            <StatusBadge status="demo" />
            <span>
              Las notas DEMO muestran el formato editorial y no describen trabajo técnico real.
            </span>
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .filter-bar-blog {
    border: 1px solid var(--color-line);
    padding-inline: 0.8rem;
    background: rgba(11, 19, 29, 0.4);
  }

  .post-list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  .post-item {
    border-bottom: 1px solid var(--color-line);
  }

  .post-link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.6rem;
    padding: 1.2rem 0;
    transition:
      background 160ms ease,
      padding 160ms ease;
  }

  .post-link:hover {
    background: rgba(16, 26, 38, 0.4);
    padding-inline: 0.7rem;
  }

  .post-index {
    display: none;
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--color-accent);
  }

  .post-main {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.35rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .post-category {
    color: var(--color-accent);
  }

  .post-title {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    transition: color 160ms ease;
    text-wrap: pretty;
  }

  .post-link:hover .post-title {
    color: var(--color-accent);
  }

  .post-desc {
    max-width: 76ch;
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .post-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    transition:
      color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .post-link:hover .post-arrow {
    color: var(--color-accent);
    border-color: rgba(86, 220, 232, 0.4);
    transform: translate(2px, -2px);
  }

  .post-item-featured {
    background: linear-gradient(90deg, rgba(86, 220, 232, 0.035), transparent 65%);
  }

  .post-item-featured .post-title {
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    letter-spacing: -0.04em;
  }

  .post-item-featured .post-desc {
    font-size: 0.92rem;
  }

  @media (min-width: 760px) {
    .post-link {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      gap: 1.2rem;
      padding: 1.5rem 0;
      align-items: start;
    }
    .post-index {
      display: block;
    }
    .post-link:hover {
      padding-inline: 0.8rem;
    }
  }

  @media (min-width: 900px) {
    .filter-bar-blog {
      grid-template-columns: minmax(14rem, 1.5fr) minmax(9rem, 0.8fr) minmax(9rem, 0.8fr) auto;
    }
  }
</style>
