---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LabCard from '../../components/LabCard.astro';
import Icon from '../../components/Icon.astro';
import { modules, documentationLabels } from '../../data/modules';
import { site } from '../../data/site';
import { countByStatus, formatDate, getLabs, labModuleGroups, unique } from '../../lib/content';
import { withBase } from '../../lib/url';

const labs = await getLabs();
const counts = countByStatus(labs);
const groups = labModuleGroups(labs);
const categories = unique(labs.flatMap((entry) => entry.data.categories)).sort((a, b) =>
  a.localeCompare(b, 'es'),
);
const modulesWithContent = modules.length;
---

<BaseLayout
  title="SOC Labs"
  description="Laboratorios del programa SOC Analyst (CSA) de EC-Council, organizados por módulo y con el estado de documentación de cada práctica."
  noindex={false}
>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">SOC Labs / Archivo</p>
      <h1 class="page-title">El laboratorio,<br /><em>por módulos.</em></h1>
      <p class="page-lede">
        Prácticas del programa SOC Analyst (CSA) de EC-Council. Cada módulo conserva
        su título original y cada informe incluye objetivo, procedimiento, evidencia
        y análisis de resultados.
      </p>

      <div class="stat-row">
        <div class="stat">
          <strong>{String(modulesWithContent).padStart(2, '0')}</strong>
          <span>Módulos documentados</span>
        </div>
        <div class="stat">
          <strong>{String(site.course.labsCompleted).padStart(2, '0')}</strong>
          <span>Prácticas realizadas</span>
        </div>
        <div class="stat">
          <strong>{String(counts.published).padStart(2, '0')}</strong>
          <span>Informes publicados</span>
        </div>
      </div>

      <p class="page-meta">
        <span>Última entrada: {formatDate(labs[0]?.data.date)}</span>
        <span>{modulesWithContent} módulos documentados</span>
        <span>Registro audiovisual en cada práctica</span>
      </p>
    </div>
  </header>

  <div class="filter-shell" id="filtros">
    <div class="wrap">
      <form class="filter-bar" id="lab-filter-form" role="search">
        <div class="field">
          <label for="lab-search">Buscar</label>
          <div class="search-field">
            <Icon name="search" size={14} />
            <input
              class="input"
              id="lab-search"
              name="q"
              type="search"
              placeholder="Título, etiqueta, herramienta…"
              autocomplete="off"
            />
          </div>
        </div>

        <div class="field">
          <label for="lab-module">Módulo</label>
          <select class="select" id="lab-module" name="module">
            <option value="all">Todos</option>
            {modules.map((module) => (
              <option value={module.id}>{module.id} · {module.label}</option>
            ))}
          </select>
        </div>

        <div class="field">
          <label for="lab-category">Categoría</label>
          <select class="select" id="lab-category" name="category">
            <option value="all">Todas</option>
            {categories.map((category) => <option value={category}>{category}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="lab-sort">Orden</label>
          <select class="select" id="lab-sort" name="sort">
            <option value="newest">Fecha · recientes</option>
            <option value="oldest">Fecha · antiguas</option>
            <option value="practice">Número de práctica</option>
          </select>
        </div>

        <div class="filter-actions">
          <button class="filter-reset" type="reset" form="lab-filter-form">Limpiar</button>
        </div>
      </form>
      <p class="filter-count" id="lab-count" aria-live="polite">
        {counts.total} prácticas · agrupadas por módulo
      </p>
    </div>
  </div>

  <nav class="wrap" aria-label="Saltar a un módulo">
    <div class="module-jump">
      {
        modules.map((module) => (
          <a href={`#${module.slug}`}>
            <b>{module.id}</b>
            <span>{module.label}</span>
          </a>
        ))
      }
    </div>
  </nav>

  <div class="wrap">
    <div id="lab-archive">
      {
        groups.map(({ module, labs: entries }) => (
          <section
            class="module-block"
            id={module.slug}
            data-module-group
            data-module-id={module.id}
            aria-labelledby={`${module.slug}-title`}
          >
            <div class="module-head">
              <div class="module-number">
                <strong>{module.id}</strong>
                <span>/ CSA</span>
              </div>

              <div>
                <h2 class="module-title" id={`${module.slug}-title`}>{module.title}</h2>
                <p class="module-desc">{module.description}</p>
                <ul class="module-areas" aria-label="Áreas de conocimiento">
                  {module.areas.map((area) => <li class="tag">{area}</li>)}
                </ul>
                <div class="module-meta">
                  <span class="badge badge-module">{documentationLabels[module.documentation]}</span>
                  <span class="module-count">
                    <b>{entries.length}</b> práctica{entries.length === 1 ? '' : 's'}
                  </span>
                </div>
              </div>

              <div class="module-aside">
                <span class="badge badge-module badge-no-dot">
                  {entries.length} registro{entries.length === 1 ? '' : 's'}
                </span>
                <a class="link-arrow" href={`?module=${module.id}#filtros`}>
                  Aislar módulo <Icon name="arrow-up-right" size={12} />
                </a>
              </div>
            </div>

            <div class="lab-grid">
              {entries.map((entry) => <LabCard entry={entry} />)}
            </div>
          </section>
        ))
      }
    </div>

    <div class="empty-state" id="lab-empty" hidden>
      <h3>Ninguna práctica coincide con el filtro.</h3>
      <p>Prueba con otro módulo, otra categoría o limpia la búsqueda.</p>
      <button class="btn btn-ghost mt-5" type="reset" form="lab-filter-form">Limpiar filtros</button>
    </div>
  </div>

  <div class="wrap">
    <section class="lab-footer-note" aria-label="Sobre esta sección">
      <p class="micro-label">Nota de alcance</p>
      <p>
        Solo se publican prácticas completas, con su informe, sus evidencias y su
        registro audiovisual. Los módulos se listan con los títulos originales del
        programa.
      </p>
      <a class="link-arrow" href={withBase('/about/')}>
        Método de documentación <Icon name="arrow-up-right" size={12} />
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .lab-footer-note {
    display: grid;
    gap: 0.6rem;
    margin-block: 3rem 5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .lab-footer-note p {
    max-width: 70ch;
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .lab-footer-note .link-arrow {
    margin-top: 0.2rem;
  }
</style>
